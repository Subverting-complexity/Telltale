<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Telltale.Viewer</RootNamespace>
    <AssemblyName>TelltaleViewer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <Target Name="BuildFrontend" BeforeTargets="Build;Publish" Condition="Exists('../frontend/package.json')">
    <!--
      The install runs every build. It used to be conditioned on
      ../frontend/node_modules being absent, which tested that a directory
      exists rather than that its contents match package-lock.json, so a partial
      install was never repaired and surfaced as missing-module errors from the
      line below. npm install is a no-op against a complete tree and repairs an
      incomplete one.
    -->
    <Exec Command="npm install" WorkingDirectory="../frontend" />
    <Exec Command="npm run build" WorkingDirectory="../frontend" />
  </Target>

</Project>
