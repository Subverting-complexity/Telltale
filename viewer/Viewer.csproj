<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Telltale.Viewer</RootNamespace>
    <NoWarn>NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.7" />
  </ItemGroup>

  <Target Name="BuildFrontend" BeforeTargets="Build;Publish" Condition="Exists('../frontend/package.json')">
    <Exec Command="npm install --prefix ../frontend" Condition="!Exists('../frontend/node_modules')" />
    <Exec Command="npm run build --prefix ../frontend" />
  </Target>

</Project>
